{
  "name": "@teleprompter/xcstrings-mcp-server",
  "version": "0.1.2",
  "description": "MCP server for manipulating Xcode string catalogs via xcstrings-cli",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "xcstrings-mcp-server": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "mcp",
    "xcstrings",
    "xcode",
    "localization"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Teleprompter-llc/ios-xcstring-catalog-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "xcstrings-cli": "1.1.0",
    "yargs": "^18.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
